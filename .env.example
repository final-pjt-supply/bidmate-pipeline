# docker-compose용 환경변수 템플릿. 복사해서 .env로 채운다: cp .env.example .env
# .env는 절대 커밋하지 말 것 (.gitignore 확인).

# ── RDS (Airflow 메타DB) ──
RDS_HOST=your-airflow.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=airflow
RDS_USER=airflow
RDS_PASSWORD=change-me

# ── Airflow ──
# 컨테이너가 마운트 볼륨(logs 등)에 쓸 때 소유권 문제를 피하려면 호스트 uid로: id -u
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# openssl rand -hex 32
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# ── 수집·다운로드 스크립트 ──
# 조달청 Decoding 키 (Encoding 키 넣으면 이중 인코딩으로 인증 에러)
G2B_SERVICE_KEY=your-decoding-key
S3_BUCKET_NAME=bidmate
AWS_DEFAULT_REGION=ap-northeast-2
# AWS 자격증명은 EC2 IAM 역할로 주입 — 여기에 AWS_ACCESS_KEY_ID 등을 넣지 말 것.
