# BidMate API 서버 접속 설정 예시. 실제 값은 .env(gitignore됨)에 복사해 채운다.
#   cp app/.env.example .env   (리포 루트에 두면 pydantic-settings가 읽음)

# ── 로컬 개발(db/docker-compose.yml) ─────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bidding_agent
POSTGRES_USER=bidding_agent
POSTGRES_PASSWORD=bidding_agent
# POSTGRES_SSLMODE=            # 로컬 docker는 비움

# ── private RDS를 SSH 터널로 붙을 때 ─────────────────────────
# 1) 베스천 경유 포트 포워딩(로컬 docker 5432와 안 겹치게 5433 권장):
#      ssh -N -L 5433:<rds-endpoint>.rds.amazonaws.com:5432 <user>@<bastion>
# 2) 아래를 .env에 세팅(HOST는 터널 로컬 끝점이라 localhost):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=<실제 DB명>
# POSTGRES_USER=<실제 사용자>
# POSTGRES_PASSWORD=<실제 비밀번호>   # 특수문자 그대로 둬도 됨(코드가 URL-encode)
# POSTGRES_SSLMODE=require            # RDS SSL 강제 시
