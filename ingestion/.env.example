# ── AWS 자격 증명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=bidmate

# ── 조달청 나라장터 OpenAPI (data.go.kr 15129394) 서비스키 - Decoding 키 사용 — Encoding 키를 넣으면 이중 인코딩으로 인증 에러 발생
G2B_SERVICE_KEY=

# ── Postgres (Airflow 메타DB, 컨테이너 내장 — bid_table이 있는 서비스 RDS 아님) ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── 서비스 RDS (bid_table/bid_attachments가 있는 실제 DB) ──
# load_daily_to_rds 태스크(db/load_curated_daily_to_rds.py)가 사용. db/apply_schema_to_rds.py의
# build_database_url()과 동일한 규칙 — DATABASE_URL 하나로 주거나 RDS_HOST 등 개별 값으로 줘도 됨.
DATABASE_URL=

# ── Airflow ──
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# ── 수집·다운로드 스크립트 ──
G2B_SERVICE_KEY=
S3_BUCKET_NAME=bidmate
AWS_DEFAULT_REGION=ap-northeast-2
