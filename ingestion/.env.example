# ── AWS 자격 증명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=bidmate

# ── 조달청 나라장터 OpenAPI (data.go.kr 15129394) 서비스키 - Decoding 키 사용 — Encoding 키를 넣으면 이중 인코딩으로 인증 에러 발생
G2B_SERVICE_KEY=

# ── Postgres (Airflow 메타DB, 컨테이너 내장) ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Airflow ──
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# ── 수집·다운로드 스크립트 ──
G2B_SERVICE_KEY=
S3_BUCKET_NAME=bidmate
AWS_DEFAULT_REGION=ap-northeast-2

