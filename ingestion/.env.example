# ── AWS 자격 증명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=bidmate

# ── 조달청 나라장터 OpenAPI (data.go.kr 15129394) 서비스키 - Decoding 키 사용 — Encoding 키를 넣으면 이중 인코딩으로 인증 에러 발생
G2B_SERVICE_KEY=

# ── Postgres (Airflow 메타DB, 컨테이너 내장) ──
# 아래 STATS_DB_*와 다른 DB다. 이건 Airflow가 자기 상태를 저장하는 곳이다.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── 서비스 RDS (bid_stats_refresh DAG 전용) ──
# 통계 matview를 갱신하려면 실제 서비스 DB에 붙어야 한다. 위 POSTGRES_*를 재사용하면
# Airflow 메타DB에 붙어 "relation bid_stats does not exist"로 끝난다.
# 값은 백엔드 .env의 POSTGRES_*와 같다(같은 RDS).
STATS_DB_HOST=
STATS_DB_PORT=5432
STATS_DB_NAME=
STATS_DB_USER=
STATS_DB_PASSWORD=
# RDS는 SSL 필수. 로컬 docker(무SSL)로 붙일 때만 disable.
STATS_DB_SSLMODE=require

# ── Airflow ──
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# ── 수집·다운로드 스크립트 ──
G2B_SERVICE_KEY=
S3_BUCKET_NAME=bidmate
AWS_DEFAULT_REGION=ap-northeast-2

